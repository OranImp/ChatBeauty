{
  "name": "chatbeauty",
  "version": "0.5.2",
  "license": "MIT",
  "author": "OranImp",
  "description": "Minimalist cross-platform AI chat client with ChatGPT-grade mathematical, SVG, Mermaid, ECharts, and interactive rendering.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "build:web": "vite build",
    "build:electron": "tsc -p electron/tsconfig.electron.json && node scripts/finalize-electron.mjs",
    "build": "pnpm build:web && pnpm build:electron",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && pnpm build:electron && electron .\"",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "cap:sync": "pnpm build:web && npx cap sync android",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.6.10",
    "@capacitor/keyboard": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "dexie": "^4.0.11",
    "dompurify": "^3.2.4",
    "echarts": "^5.6.0",
    "katex": "^0.16.21",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^1.29.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "wait-on": "^8.0.3"
  }
}
